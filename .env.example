# ==============================================================================
# TenderX Platform Configuration Environment Variables
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="TenderX - AI Tender Management Platform"
API_V1_STR=/api/v1

# Security & Authentication
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL with pgvector)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tenderx_user
POSTGRES_PASSWORD=tenderx_password
POSTGRES_DB=tenderx_db
DATABASE_URL=postgresql://tenderx_user:tenderx_password@localhost:5432/tenderx_db

# File Storage Configuration
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=25

# AI & Embedding Configuration (Local-First)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# CORS Configuration (Frontend Origins)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# Initial Admin User Seed
FIRST_SUPERUSER_EMAIL=admin@tenderx.local
FIRST_SUPERUSER_PASSWORD=AdminPassword123!
FIRST_SUPERUSER_NAME="Tender Manager"
